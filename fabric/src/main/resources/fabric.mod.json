{
  "schemaVersion": 1,
  "id": "peakclient",
  "version": "${version}",
  "name": "Peak Client",
  "description": "This is an example description! Tell everyone what your mod is about!",
  "authors": [
    "GekidoLukas"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/peakclient/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.gekidolukas.peakclient.fabric.PeakClientModFabric"
    ],
    "client": [
      "net.gekidolukas.peakclient.fabric.client.PeakClientModFabricClient"
    ]
  },
  "mixins": [
    "peakclient.mixins.json",
    "peakclient-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
}
