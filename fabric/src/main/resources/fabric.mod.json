{
  "schemaVersion": 1,
  "id": "peakclient",
  "version": "${version}",
  "name": "PeakClient",
  "description": "Client side of PeakClient, a server-driven HUD and menu system. Server mods describe an interface (HUD elements, menus, minimaps, charts and more) and this mod renders it on your screen. Install it on the client to see the interfaces of servers that use PeakClient.",
  "authors": [
    "GekidoLukas"
  ],
  "contact": {
    "homepage": "https://gekidolukas.com",
    "sources": "https://github.com/GekidoLukas/peakclient",
    "issues": "https://github.com/GekidoLukas/peakclient/issues"
  },
  "license": "GPL-3.0-only",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.gekidolukas.peakclient.fabric.PeakClientModFabric"
    ],
    "client": [
      "net.gekidolukas.peakclient.fabric.client.PeakClientModFabricClient"
    ]
  },
  "mixins": [
    "peakclient.mixins.json",
    "peakclient-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
